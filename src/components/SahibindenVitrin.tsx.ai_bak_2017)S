                      <td style={{ padding: '10px', fontSize: '11px' }}><div>RSI: <strong>{x.rsi ?? '-'}</strong> | EMA20: <strong>{x.ort20 ?? '-'}</strong></div><div style={{ color: '#666' }}>{x.likidite || '-'}</div><div style={{ color: '#8e44ad', fontWeight: 'bold', marginTop: '2px' }}>Q:{x.q_sk ?? '-'} V:{x.v_sk ?? '-'} M:{x.m_sk ?? '-'} • QVM:{x.qvm ?? '-'}</div></td>
                      <td style={{ padding: '10px' }}><span style={{ padding: '4px 8px', borderRadius: '4px', fontSize: '11px', fontWeight: 'bold', background: x.karar === 'PROCEED' ? '#d4edda' : x.karar === 'IZLE' ? '#e8f4f8' : '#f8d7da', color: x.karar === 'PROCEED' ? '#155724' : x.karar === 'IZLE' ? '#0c5460' : '#721c24' }}>{x.skor ?? 50}/100 • {x.sinyal || x.karar}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {secili && (
              <div onClick={() => setSecili(null)} style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.55)', zIndex: 9998, display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '16px' }}>
              <div onClick={(e) => e.stopPropagation()} style={{ width: '100%', maxWidth: '880px', maxHeight: '90vh', overflowY: 'auto', boxShadow: '0 10px 30px rgba(0,0,0,0.4)' }}>
              <div style={{ marginTop: '16px', background: '#fff', border: '1px solid #ccc', borderRadius: '4px', padding: '16px' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '10px' }}>
                  <strong>📋 {secili.sembol} — 5 Katmanlı Pro Ekspertiz ({secili.sinyal || secili.karar})</strong>
                  <button onClick={() => setSecili(null)} style={{ border: 'none', background: 'none', cursor: 'pointer', fontWeight: 'bold' }}>✕ Kapat</button>
                </div>
                <div style={{ display: 'flex', gap: '14px', flexWrap: 'wrap' }}>
                  <div style={{ width: '230px', display: 'flex', flexDirection: 'column', gap: '6px' }}>
                    {[
                      ['1', '📊 1. Temel & Adli Analiz'],
                      ['2', '🔬 2. Mikroyapı & L2'],
                      ['3', '🏦 3. Takas & Kurumsal (AKD)'],
                      ['4', '📈 4. Teknik & Rejim'],
                      ['5', '📰 5. Katalizör, NLP & Makro']
                    ].map(([id, ad]) => (
                      <button key={id} onClick={() => setSekme(Number(id))} style={{ textAlign: 'left', padding: '9px 12px', borderRadius: '4px', border: '1px solid #ddd', cursor: 'pointer', background: sekme === Number(id) ? '#2c3e50' : '#f8f9fa', color: sekme === Number(id) ? '#fff' : '#222', fontWeight: sekme === Number(id) ? 'bold' : 'normal', fontSize: '12px' }}>
                        {ad}
                      </button>
                    ))}
                  </div>
                  <div style={{ flex: 1, minWidth: '300px', background: '#f9f9f9', padding: '12px', borderRadius: '4px', border: '1px solid #eee' }}>
                    {secili.ohlc && secili.ohlc.length > 2 && <BesKatmanGrafik item={secili} />}
                    <div style={{ display: 'flex', gap: '12px', alignItems: 'center', background: '#fff', border: '1px solid #e5e5e5', padding: '8px 12px', borderRadius: '4px', marginBottom: '10px', flexWrap: 'wrap' }}>
                      {secili.radar && secili.radar.length === 5 && (() => {
                        const r = secili.radar;
                        const pts = r.map((val: number, i: number) => {
                          const ang = (Math.PI * 2 * i) / 5 - Math.PI / 2;
                          const rad = (val / 100) * 34;
                          return `${45 + rad * Math.cos(ang)},${45 + rad * Math.sin(ang)}`;
                        }).join(' ');
                        return (
                          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                            <svg width="90" height="90">
                              <circle cx="45" cy="45" r="34" fill="none" stroke="#eee" />
                              <circle cx="45" cy="45" r="17" fill="none" stroke="#eee" />
                              <polygon points={pts} fill="rgba(46, 204, 113, 0.35)" stroke="#27ae60" strokeWidth="2" />
                            </svg>
                            <div style={{ fontSize: '11px', lineHeight: '1.4' }}>
                              <strong>❄️ Snowflake Ekspertiz Özeti</strong><br/>
                              Kalite: {r.at(0)} | L2: {r.at(1)} | Takas: {r.at(2)}<br/>
                              Teknik: {r.at(3)} | Makro: {r.at(4)} • <strong>QVM: {secili.qvm ?? '-'}</strong>
                            </div>
                          </div>
                        );
                      })()}
                      <div style={{ flex: 1, minWidth: '180px', fontSize: '11px' }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '3px' }}>
                          <strong>📊 ATAS Kümülatif Net Delta (Alıcı vs Satıcı)</strong>
                          <span>%{secili.obi ?? 0}</span>
                        </div>
                        <div style={{ height: '10px', background: '#fadbd8', borderRadius: '5px', overflow: 'hidden' }}>
                          <div style={{ width: `${Math.min(100, Math.max(5, 50 + (secili.obi || 0) / 2))}%`, height: '100%', background: '#27ae60' }} />
                        </div>
                      </div>
                    </div>
                    <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '12px', background: '#fff', border: '1px solid #e5e5e5' }}>
                      <thead>
                        <tr style={{ background: '#eef2f5', borderBottom: '1px solid #ddd', textAlign: 'left' }}>
                          <th style={{ padding: '7px 9px' }}>2. Alt Kontrol Noktası</th>
                          <th style={{ padding: '7px 9px' }}>3. MT16 Motor / Metrik</th>
                          <th style={{ padding: '7px 9px' }}>Ekspertiz Sonucu</th>
                        </tr>
                      </thead>
                      <tbody>
                        {(secili.ekspertiz?.[String(sekme)] || []).map((row: any, idx: number) => (
                          <tr key={idx} style={{ borderBottom: '1px solid #f0f0f0' }}>
                            <td style={{ padding: '8px 9px', fontWeight: 'bold', color: '#2c3e50' }}>• {row.dal}</td>
                            <td style={{ padding: '8px 9px', color: '#666' }}>{row.metrik}</td>
                            <td style={{ padding: '8px 9px', fontWeight: 'bold', color: '#1f618d' }}>{row.sonuc}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
                <div style={{ marginTop: '12px', paddingTop: '12px', borderTop: '1px solid #ddd', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '10px' }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '8px', fontSize: '13px' }}>
                    <strong>💰 Bütçe:</strong>
                    <input type="number" value={butce} onChange={e => setButce(Number(e.target.value) || 0)} style={{ width: '100px', padding: '5px', border: '1px solid #ccc', borderRadius: '4px' }} />
                    <span>{secili.piyasa === 'BIST' ? '₺' : '$'} ➔ <strong>{secili.fiyat > 0 ? Math.floor((butce / secili.fiyat) * 100) / 100 : 0} Lot / Adet</strong></span>
                  </div>
                  <div style={{ display: 'flex', gap: '8px' }}>
                    <button onClick={() => portfoyeEkle(secili)} style={{ background: '#27ae60', color: '#fff', border: 'none', padding: '7px 14px', borderRadius: '4px', cursor: 'pointer', fontWeight: 'bold', fontSize: '12px' }}>✅ ONAYLA (Portföye Ekle)</button>
                    <button onClick={() => { setElenenler([...elenenler, secili.sembol]); setSecili(null); }} style={{ background: '#e74c3c', color: '#fff', border: 'none', padding: '7px 14px', borderRadius: '4px', cursor: 'pointer', fontWeight: 'bold', fontSize: '12px' }}>❌ ELE</button>
                  </div>
                </div>
              </div>
              </div>
              </div>
            )}
          </div>
        </div>
      )}
    
          {galeriAcik && <ModulGalerisiModal onClose={() => setGaleriAcik(false)} />}
          {onarimAcik && (
        <div onClick={() => acKapatOnarim(false)} style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.55)", zIndex: 9999, display: "flex", alignItems: "center", justifyContent: "center", padding: "16px" }}>
          <div onClick={(e) => e.stopPropagation()} style={{ background: "#fff", borderRadius: "6px", width: "94vw", maxWidth: "1200px", height: "85vh", maxHeight: "85vh", display: "flex", flexDirection: "column", overflowY: "auto", padding: "16px" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", borderBottom: "1px solid #eee", paddingBottom: "8px", marginBottom: "10px" }}>
              <strong style={{ fontSize: "14px", color: "#1b5e20" }}>🩺 MT16 Otonom Python Tamir & Sağlık Bekçisi (7/24)</strong>
              <button onClick={() => acKapatOnarim(false)} style={{ border: "1px solid #ccc", background: "#f5f5f5", borderRadius: "3px", padding: "3px 8px", cursor: "pointer" }}>Kapat ✕</button>
            </div>
            <div style={{ background: "#0d1117", color: "#00ff66", padding: "12px", borderRadius: "6px", marginBottom: "12px", fontFamily: "monospace", border: "1px solid #30363d" }}>
              <div style={{ display: "flex", gap: "6px", marginBottom: "8px", flexWrap: "wrap", alignItems: "center" }}>
                <input type="password" value={cmdPin} onChange={(e) => guncellePin(e.target.value)} placeholder="PIN" title="CMD Güvenlik PIN" style={{ width: "74px", background: "#1c1010", color: "#ff8a80", border: "1px solid #6e2c2c", borderRadius: "4px", padding: "5px 8px", fontSize: "12px", fontFamily: "monospace", textAlign: "center" }} />
                <button onClick={() => calistirCmd("pm2 status")} style={{ background: "#161b22", color: "#58a6ff", border: "1px solid #30363d", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>📊 PM2 Durumu</button>
                <button onClick={() => calistirCmd("find . -maxdepth 3 -not -path '*/.*' -not -path './node_modules*' -not -path './dist*' | sort")} style={{ background: "#161b22", color: "#7ee787", border: "1px solid #30363d", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>📂 Dosya Ağacı</button>
                <button onClick={() => calistirCmd("cat data/sanal_portfoy.json")} style={{ background: "#161b22", color: "#d2a8ff", border: "1px solid #30363d", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>💰 Sanal Portföy</button>
                <button onClick={() => calistirCmd("head -n 25 data/qodi_autofix_log.json")} style={{ background: "#161b22", color: "#ffa657", border: "1px solid #30363d", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>🩺 Bekçi Logu</button>
                <button onClick={() => calistirCmd("npm run build && pm2 restart bistapp")} style={{ background: "#2d1b00", color: "#ffdf5d", border: "1px solid #6e4c00", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>🏗️ Build & Yayınla</button>
                <button onClick={() => aiSor("data/sanal_portfoy.json icindeki acik pozisyonlari, hedef/stop oranlarini ve python/otonom_beyin.py sagligini analiz et")} style={{ background: "#2b1d42", color: "#d2a8ff", border: "1px solid #6e40c9", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>🧠 AI Portföy Analizi</button>
                <button onClick={() => aiSor("pm2 logs --nostream --lines 25 ciktisini incele ve hata varsa acikla")} style={{ background: "#2b1d42", color: "#d2a8ff", border: "1px solid #6e40c9", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>🔍 AI Log Denetimi</button>
                <button onClick={aiYedekGeriAl} style={{ background: "#2a1616", color: "#ffa198", border: "1px solid #6e2c2c", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>↩️ AI Yedeği Geri Al</button> <button onClick={() => calistirCmd("git diff --stat && git diff | head -n 40")} style={{ background: "#16222a", color: "#7ee787", border: "1px solid #238636", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>📜 Son Diff Gör</button> <button onClick={() => calistirCmd("git diff --stat && git diff | head -n 40")} style={{ background: "#16222a", color: "#7ee787", border: "1px solid #238636", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>📜 Son Diff Gör</button>
                <button onClick={() => setCmdCikti("")} style={{ marginLeft: "auto", background: "#21262d", color: "#8b949e", border: "1px solid #30363d", borderRadius: "4px", padding: "5px 9px", fontSize: "11px", cursor: "pointer" }}>🧹 Temizle</button>
              </div>
              <div style={{ display: "flex", gap: "8px", marginBottom: "8px", alignItems: "stretch" }}>
                <textarea rows={3} value={cmdGirdi} onChange={(e) => setCmdGirdi(e.target.value)} onKeyDown={(e) => { if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) { e.preventDefault(); calistirCmd(); } else if (e.key === "ArrowUp" && cmdGecmis.length > 0) { const ni = Math.min(gecmisIdx + 1, cmdGecmis.length - 1); setGecmisIdx(ni); setCmdGirdi(cmdGecmis[ni]); } else if (e.key === "ArrowDown") { if (gecmisIdx > 0) { const ni = gecmisIdx - 1; setGecmisIdx(ni); setCmdGirdi(cmdGecmis[ni]); } else { setGecmisIdx(-1); setCmdGirdi(""); } } }} placeholder="Tek veya çok satırlı Bash / Python3 komutu yazın... (Çalıştırmak için Ctrl+Enter veya sağdaki butona basın)" style={{ flex: 1, background: "#010409", color: "#7ee787", border: "1px solid #30363d", borderRadius: "4px", padding: "8px 10px", fontSize: "12.5px", fontFamily: "monospace", resize: "vertical" }} />
                <button onClick={aiIleGelistir} style={{ background: "#6e40c9", color: "#fff", border: "none", borderRadius: "4px", padding: "0 14px", fontSize: "12.5px", fontWeight: "bold", cursor: "pointer" }}>🤖 AI Geliştir<br/><span style={{ fontSize: "10px", fontWeight: "normal", opacity: 0.9 }}>(LLM Ajanı)</span></button>
                <button onClick={() => calistirCmd()} style={{ background: "#238636", color: "#fff", border: "none", borderRadius: "4px", padding: "0 16px", fontSize: "12.5px", fontWeight: "bold", cursor: "pointer" }}>Çalıştır ↵<br/><span style={{ fontSize: "10px", fontWeight: "normal", opacity: 0.85 }}>(Ctrl+Enter)</span></button>
              </div>
              {cmdBloklar.length > 0 && <div style={{ display: "flex", flexDirection: "column", gap: "8px", maxHeight: "42vh", overflowY: "auto", marginBottom: "8px" }}>{cmdBloklar.map(b => { const hatali = /error|traceback|failed|exception|hata/i.test(b.cikti); return (<div key={b.id} style={{ background: "#010409", border: hatali ? "1px solid #da3633" : "1px solid #30363d", borderRadius: "6px", padding: "8px 10px" }}><div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "4px", fontSize: "11px", color: "#8b949e" }}><span>[{b.zaman}] <strong style={{ color: "#7ee787" }}>$ {b.komut}</strong></span><div style={{ display: "flex", gap: "6px" }}>{hatali && <button onClick={() => aiSor(`Su komutun hatasini analiz et ve cozum oner: ${b.komut} -> ${b.cikti.slice(0,400)}`)} style={{ background: "#6e40c9", color: "#fff", border: "none", borderRadius: "4px", padding: "2px 8px", fontSize: "10.5px", cursor: "pointer" }}>🩺 Hatayı AI ile Çöz</button>}<button onClick={() => navigator.clipboard?.writeText(b.cikti)} style={{ background: "#21262d", color: "#c9d1d9", border: "1px solid #30363d", borderRadius: "4px", padding: "2px 7px", fontSize: "10.5px", cursor: "pointer" }}>📋 Kopyala</button></div></div><pre style={{ margin: 0, whiteSpace: "pre-wrap", fontSize: "11.5px", color: hatali ? "#ffa198" : "#c9d1d9", maxHeight: "180px", overflowY: "auto" }}>{b.cikti}</pre></div>); })}</div>}<pre style={{ margin: 0, display: cmdBloklar.length > 0 ? "none" : "block", height: "42vh", maxHeight: "42vh", background: "#010409", padding: "10px", borderRadius: "4px", border: "1px solid #21262d", fontSize: "12px", lineHeight: "1.45", overflowY: "auto", whiteSpace: "pre-wrap", color: "#c9d1d9" }}>{cmdCikti}</pre>
            </div>
            {!Array.isArray(onarimKayitlar) || onarimKayitlar.length === 0 ? <div style={{ fontSize: "12px", color: "#666" }}>Bekçi aktif — kayıtlar güncelleniyor...</div> : (Array.isArray(onarimKayitlar) ? onarimKayitlar : []).map((k: any, i: number) => (
              <div key={i} style={{ padding: "7px 10px", borderBottom: "1px solid #f0f0f0", fontSize: "12px", background: k.durum === "ONARILDI" ? "#fff8e1" : "#f4fbf7", marginBottom: "4px", borderRadius: "4px" }}>
                <strong>[{k.zaman}] {k.durum}:</strong> {k.mesaj}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
