import os, sys, json, shutil, subprocess, urllib.request, time
from datetime import datetime

for l in open("/home/bytrkr/bistapp/.env", encoding="utf-8", errors="ignore"):
    if "=" in l and not l.startswith("#"):
        k, v = l.strip().split("=", 1)
        os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))

args = list(sys.argv[1:])
mod_tipi = "build"
if len(args) >= 2 and args[0] == "--mode":
    mod_tipi = args[1].lower()
    args = args[2:]
istek = " ".join(args).strip()

agac = "\n".join(
    os.path.join(r, f)
    for r, d, fs in os.walk(".")
    if "node_modules" not in r and "/.git" not in r and "./dist" not in r
    for f in fs
)[:3500]

mod_kurallari = {
    "plan": "MOD: PLAN (SALT-OKUNUR). Dosya yazmak, silmek veya servis restart etmek KESINLIKLE YASAK. Sadece okuma (cat, head, grep, git status) yap ve ayrintili eylem plani uret.",
    "build": "MOD: BUILD (YEDEKLI GELISTIRICI). Tek bir dosyada guvenli degisiklik yap ve gerekirse npm run build ile dogrula.",
    "hack": "MOD: HACK / YOLO (COK ADIMLI OTONOM REACT). Hedefe ulasana kadar en fazla 3 adimda komutu calistir, ciktisini gozlemle, hata varsa duzelt ve dogrula. Bitince bitti=true dondur.",
    "audit": "MOD: AUDIT (GUVENLIK & ANAYASA DENETIMI). Salt-okunur komutlarla .env izinlerini, /api/cmd PIN korumasini, PM2 sagligini ve docs/CLAUDE.md kurallarini denetleyip 100 uzerinden puan ver."
}

sys_prompt = f"""Sen MT16 QuantMind otonom terminal ajanisin.
{mod_kurallari.get(mod_tipi, mod_kurallari["build"])}
SADECE gecerli JSON dondur:
{{"aciklama":"Adimin kisa Turkce ozeti","dosya":"Duzenlenecek dosya yolu veya bos","komut":"Calistirilacak bash komutu","bitti":true}}
Proje Dosyalari:
{agac}"""

key = os.environ.get("GROQ_API_KEY")
hdrs = {"Content-Type": "application/json", "Authorization": f"Bearer {key}", "User-Agent": "MT16-Agent/3.0"}
mesajlar = [{"role": "system", "content": sys_prompt}, {"role": "user", "content": istek}]
max_tur = 3 if mod_tipi == "hack" else 1

for tur in range(1, max_tur + 1):
    body = json.dumps({"model": "qwen/qwen3.8-27b", "messages": mesajlar, "temperature": 0.1}).encode()
    res = json.loads(urllib.request.urlopen(urllib.request.Request("https://api.groq.com/openai/v1/chat/completions", data=body, headers=hdrs), timeout=45).read().decode())
    txt = res["choices"][0]["message"]["content"].strip()
    if txt.startswith("```"):
        txt = txt.split("```")[1]
        if txt.startswith("json"): txt = txt[4:]
    plan = json.loads(txt.strip(), strict=False)
    print(f"[{mod_tipi.upper()} | Tur {tur}/{max_tur}] {plan.get('aciklama', '')}")
    dosya = plan.get("dosya", "").strip()
    if dosya and mod_tipi in ("build", "hack") and os.path.isfile(dosya):
        yedek = f"{dosya}.ai_bak_{datetime.now().strftime('%H%M%S')}"
        shutil.copy2(dosya, yedek)
        print(f"💾 Yedek alindi: {yedek}")
    komut = plan.get("komut", "").strip()
    if komut:
        if mod_tipi in ("plan", "audit") and any(w in komut for w in ["rm ", "mv ", "pm2 restart", "write_text", "> "]):
            print("🛡️ Salt-okunur mod korumasi: Yazma/restart komutu engellendi.")
            break
        r = subprocess.run(komut, shell=True, capture_output=True, text=True, timeout=120)
        cikti = (r.stdout + r.stderr).strip() or "Tamamlandi."
        print(cikti[:2500])
        mesajlar.append({"role": "assistant", "content": json.dumps(plan)})
        mesajlar.append({"role": "user", "content": f"Komut ciktisi:\n{cikti[:1800]}\nHedef tamamlandiysa bitti=true dondur."})
    if plan.get("bitti", True):
        break
