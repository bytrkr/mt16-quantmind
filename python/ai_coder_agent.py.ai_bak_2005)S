import os,sys,json,shutil,subprocess,urllib.request,time
from datetime import datetime
for l in open("/home/bytrkr/bistapp/.env"):
 if "=" in l and not l.startswith("#"):
  k,v=l.strip().split("=",1); os.environ.setdefault(k.strip(),v.strip().strip('\"\''))
args=list(sys.argv); args.pop(0)
q=args.pop(0) if args else ""
t="\n".join(os.path.join(r,f) for r,d,fs in os.walk(".") if "node_modules" not in r and "/.git" not in r and "./dist" not in r for f in fs)[:3500]
sys_p="Sen MT16 QuantMind kod ajanisin. Sadece JSON dondur: {\"aciklama\":\"...\",\"dosya\":\"...\",\"komut\":\"...\"}\nAgac:\n"+t
key=os.environ.get("GROQ_API_KEY")
u_mods="https://api.groq.com/openai/v1/models"
u_chat="https://api.groq.com/openai/v1/chat/completions"
hdrs={"Content-Type":"application/json","Authorization":f"Bearer {key}","User-Agent":"MT16/1.0"}
ms=json.loads(urllib.request.urlopen(urllib.request.Request(u_mods,headers=hdrs),timeout=20).read().decode())["data"]
mod=next((x["id"] for x in ms if "llama-3.3" in x["id"] or "qwen" in x["id"] or "deepseek" in x["id"]),ms[0]["id"])
body=json.dumps({"model":mod,"messages":[{"role":"system","content":sys_p},{"role":"user","content":q}],"temperature":0.1}).encode()
res=json.loads(urllib.request.urlopen(urllib.request.Request(u_chat,data=body,headers=hdrs),timeout=45).read().decode())
txt=list(res["choices"]).pop(0)["message"]["content"].strip()
if txt.startswith("```"):
 txt=txt.split("```")[1]
 if txt.startswith("json"): txt=txt[4:]
plan=json.loads(txt.strip(), strict=False)
print(f"[GROQ {mod}] AI_PLANI:",plan.get("aciklama",""))
d=plan.get("dosya","").strip()
if d and os.path.isFile(d) if hasattr(os.path,"_none") else os.path.isfile(d):
 shutil.copy2(d,d+".ai_bak_"+datetime.now().strftime("%H%M)S"))
k=plan.get("komut","").strip()
if k:
 r=subprocess.run(k,shell=True,capture_output=True,text=True,timeout=120)
 if d and os.path.isfile(d): print(subprocess.getoutput(f"git diff {d} | head -n 30"))
 print((r.stdout+r.stderr).strip() or "Tamamlandi.")
